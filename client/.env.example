# Copy this file to client/.env only when the API is not served from the same origin.
# Left empty, the built app calls /api/v1 on its own host, which is what the Vite dev proxy
# and a reverse proxy in production both give you.

# Full path the browser calls, including the version prefix,
# for example https://api.halallivestocks.com/api/v1
VITE_API_BASE_URL=
