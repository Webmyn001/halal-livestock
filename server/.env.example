# Copy this file to server/.env and fill every <placeholder>.
# The server refuses to boot when a value is missing or malformed, and it tells you which key failed.
# Never commit the filled in .env. Only this template belongs in git.

# ---- Runtime ----
# production turns on the guards that block console mail and local image storage.
NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string (Database > Connect > Drivers).
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Sign sessions. Generate one: node -p "require('crypto').randomBytes(32).toString('hex')"
JWT_SECRET=<64 hex characters>
JWT_EXPIRES_IN=1d

# Comma separated list of browser origins allowed to call this API.
CLIENT_ORIGIN=http://localhost:5173

BCRYPT_SALT_ROUNDS=12

# ---- Email ----
# console prints the message to the server log. brevo sends real mail.
# Production refuses console, so a live deployment needs brevo.
MAIL_PROVIDER=console
BREVO_API_KEY=<brevo secret key, empty when MAIL_PROVIDER=console>
MAIL_FROM_EMAIL=<verified sender address on the brevo account>
MAIL_FROM_NAME=Halal Livestocks

# ---- SMS ----
# console prints the code to the log. termii delivers real SMS to Nigerian numbers.
SMS_PROVIDER=console
TERMII_API_KEY=<termii API key, empty when SMS_PROVIDER=console>
TERMII_SENDER_ID=HalalLive

# Base URL used inside verification and password reset links. This is the web app.
PUBLIC_APP_URL=http://localhost:5173

# ---- Payments ----
# mock settles an order as soon as its checkout link is opened, for local testing only.
# Production refuses mock, so a live deployment needs paystack and both keys.
PAYMENT_PROVIDER=mock
PAYSTACK_SECRET_KEY=<paystack secret test key, sk_test_...>
PAYSTACK_PUBLIC_KEY=<paystack public test key, pk_test_...>
# The value you type into the Paystack webhook settings for POST /api/v1/payments/webhook
PAYSTACK_WEBHOOK_SECRET=<paystack webhook secret>

# ---- Image storage ----
# local writes files under server/uploads and serves them from this API.
# cloudinary is required in production because a deployed container has no durable disk.
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=<cloudinary cloud name>
CLOUDINARY_API_KEY=<cloudinary api key>
CLOUDINARY_API_SECRET=<cloudinary api secret>
UPLOAD_DIR=uploads

# Base URL of this API, used to build image URLs when STORAGE_PROVIDER=local.
PUBLIC_API_URL=http://localhost:4000
