# ---- Runtime ----
NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string (Database > Connect > Drivers). Replace <uri> below.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Auth — generate your own: openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-random-characters
JWT_EXPIRES_IN=1d

# Comma-separated list of allowed browser origins
CLIENT_ORIGIN=http://localhost:5173

BCRYPT_SALT_ROUNDS=12

# ---- Email ----
# console prints the message to the server log (development only, refused in production).
# brevo sends real transactional mail and needs the three values below.
MAIL_PROVIDER=console
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Halal Livestocks

# ---- SMS ----
# console prints the code to the server log. termii sends real SMS.
SMS_PROVIDER=console
TERMII_API_KEY=
TERMII_SENDER_ID=HalalLive

# Base URL used inside verification and password reset links
PUBLIC_APP_URL=http://localhost:5173

# ---- Image storage ----
# local writes files under server/uploads and serves them from this API (development only, refused in production).
# cloudinary stores the real images and needs the three values below.
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_DIR=uploads

# Base URL of this API, used to build local image URLs
PUBLIC_API_URL=http://localhost:4000
